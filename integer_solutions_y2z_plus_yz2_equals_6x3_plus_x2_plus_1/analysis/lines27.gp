
default(parisize, 4*10^9);
c18 = x^18 - 3416*x^12 + 4301476*x^6 + 929714176;
Lp = polredbest(nfsplitting(c18)); Lp = subst(Lp, x, y);
nf = nfinit(Lp);
f = 6*x^3+x^2+1; th = nfroots(nf, f);
rA=nfroots(nf,976*x^9 + 17568*x^6 + 105409*x^3 + 210816);
rB=nfroots(nf,976*x^9 + 2928*x^6 + 2901*x^3 + 976);
ra=nfroots(nf,907401035776*x^18 + 2840581632*x^12 + 2700345*x^6 + 976);
md(u)=Mod(u,Lp);
th=apply(md,th); rA=apply(md,rA); rB=apply(md,rB); ra=apply(md,ra);
Lines=List();
pl(P,Q)= my(v=vector(6),k=0); for(i=1,4,for(j=i+1,4,k++; v[k]=P[i]*Q[j]-P[j]*Q[i])); my(i=1); while(v[i]==0,i++); v/v[i];
onS(P,Q)= for(t=0,4, my(p=P+t*Q); if(p[2]^2*p[3]+p[2]*p[3]^2-6*p[1]^3-p[1]^2*p[4]-p[4]^3!=0, return(0))); 1;
addl(P,Q)= if(!onS(P,Q),return(0)); my(v=pl(P,Q)); for(k=1,#Lines, if(Lines[k][1]==v, return(0))); listput(Lines,[v,P,Q]); 1;
for(i=1,3, addl([th[i],0,0,1],[0,0,1,0]); addl([th[i],0,0,1],[0,1,0,0]); addl([th[i],0,0,1],[0,1,-1,0]));
print("K-lines ",#Lines);
for(i=1,9, a=rA[i]; for(j=1,9, c=rA[j]; if(a*c*(a+c)!=6, next); for(k=1,9, for(l=1,9, addl([1,a,c,0],[0,rB[k],rB[l],1])))));
print("chart1 ",#Lines);
for(i=1,18, a=ra[i]; for(s=1,3, c=a/th[s]; for(k=1,18, b=ra[k]; for(t=1,3, d=b/th[t]; if(-18*a^2*b - a^2*d - 2*a*b*c - 3*c^2*d + 1==0 && -18*a*b^2 - 2*a*b*d - b^2*c - 3*c*d^2 + 1==0, addl([a,1,0,c],[b,0,1,d]))))));
print("total ",#Lines);
n=#Lines; M=matrix(n,n,i,j, if(i==j,-1, if(matdet(Mat([Lines[i][2]~,Lines[i][3]~,Lines[j][2]~,Lines[j][3]~]))==0,1,0)));
print("rowsums ", vecsort(vector(n,i,sum(j=1,n,M[i,j]))));
G=galoisinit(nf); gens=G.gen; print("group order ", #G.group, " ngens ", #gens);
ap(s,e)=Mod(nfgaloisapply(nf,s,lift(e)),Lp);
perm(s)= vector(n,i, my(P=apply(e->ap(s,e),Lines[i][2]), Q=apply(e->ap(s,e),Lines[i][3])); my(v=pl(P,Q)); my(r=0); for(k=1,n, if(Lines[k][1]==v, r=k)); r);
Pm=vector(#gens,g, perm(galoispermtopol(G,gens[g])));
print("perms ", Pm);
write("lines_out.txt", [M, Pm]);
print("sqrt-3 ", #nfroots(nf, x^2+3), " sqrt-61 ", #nfroots(nf,x^2+61), " sqrt183 ", #nfroots(nf,x^2-183), " i ", #nfroots(nf,x^2+1), " sqrt2 ", #nfroots(nf, x^2-2), " sqrt-2 ", #nfroots(nf,x^2+2), " sqrt3 ", #nfroots(nf,x^2-3), " sqrt7 ",#nfroots(nf,x^2-7)," sqrt-7 ",#nfroots(nf,x^2+7));
print("cyc cubic 7: ", #nfroots(nf, x^3+x^2-2*x-1), " cyc9: ", #nfroots(nf, x^3-3*x+1));
